<div class="pet-nav-header">
  <div class="nav-content">
    <% is_home = request.path == "/" || (user_signed_in? && request.path.match?(%r{^/users/\d+/pets$})) %>
    <% show_back = !is_home %>
    <!-- Left: Back button or Logo -->
    <div class="nav-items-left">
      <% if show_back %>
        <%= link_to :back, class: "nav-link-custom back-button" do %>
          <i class="fa-solid fa-arrow-left"></i><span class="ms-2 d-none d-md-inline">Back</span>
        <% end %>
      <% else %>
        <% if user_signed_in? && current_user.present? %>
          <% brand_link = user_pets_path(current_user) %>
        <% else %>
          <% brand_link = root_path %>
        <% end %>
        <%= link_to brand_link, class: "nav-brand-text" do %>
          connectPet <i class="fa-solid fa-paw"></i>
        <% end %>
      <% end %>
    </div>
    <!-- Center: Centered logo (only when back button shows) -->
    <% if show_back %>
      <div class="nav-center">
        <% if user_signed_in? && current_user.present? %>
          <% brand_link = user_pets_path(current_user) %>
        <% else %>
          <% brand_link = root_path %>
        <% end %>
        <%= link_to brand_link, class: "nav-brand-text" do %>
          connectPet <i class="fa-solid fa-paw"></i>
        <% end %>
      </div>
    <% else %>
      <div class="nav-center"></div>
    <% end %>
    <!-- Right: Menu -->
    <div class="nav-items-right">
      <% if user_signed_in? %>
        <div class="dropdown">
          <a href="#" class="nav-link-custom" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="fa-solid fa-bars" style="font-size: 1.5rem;"></i>
          </a>
          <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
            <%= link_to "My Pets", user_pets_path(current_user), class: "dropdown-item" %>
            <%= link_to "Add a New Pet", new_user_pet_path(current_user), class: "dropdown-item" %>
            <%= link_to "Inbox", user_chats_path(current_user), class: "dropdown-item" %>
            <%# Link to archived chats, if exist %>
            <% if current_user.chats.archived.any? %>
              <%= link_to "Archived Chats", user_chats_path(current_user, archived: true), class: "dropdown-item" %>
            <% end %>
            <%# Contextual links: only show if we are looking at a specific pet %>
            <% if @pet && @pet.id %>
              <div class="dropdown-divider"></div>
              <%= link_to "Add Log for #{@pet.name}", new_user_pet_log_path(current_user, @pet), class: "dropdown-item" %>
              <%= link_to "#{@pet.name}’s Logs", user_pet_logs_path(current_user, @pet), class: "dropdown-item" %>
              <%# Link to move pet to Heart Gallery%>
              <%= link_to "Move to Heart Gallery", archive_user_pet_path(current_user, @pet), data: {turbo_method: :patch, turbo_confirm: "Move #{@pet.name} to Heart Gallery?"}, class: "dropdown-item" %>
            <% end %>
            <%# Link to archived pets, if exist %>
            <% if current_user.pets.archived.any? %>
              <%= link_to "Heart Gallery", user_pets_path(current_user, archived: true), class: "dropdown-item" %>
            <% end %>
            <div class="dropdown-divider"></div>
            <%= link_to "Log out", destroy_user_session_path, data: {turbo_method: :delete}, class: "dropdown-item text-danger" %>
          </div>
        </div>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "nav-link-custom" %>
      <% end %>
    </div>
  </div>
</div>
