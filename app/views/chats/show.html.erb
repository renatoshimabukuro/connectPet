<div class="chat-subnav">
  <div style="display: flex; align-items: center; gap: 15px; width: 100%;">
    <%= link_to user_chats_path(@user), style: "color: #4a6755;" do %>
      <i class="fa-solid fa-chevron-left"></i>
    <% end %>
  </div>
  <div class="col-11">
    <% if @user == @chat.owner %>
      <%= @chat.vet.clinic.clinic_name %>
    <% else %>
      <%= @chat.owner.name %>: <%= @chat.pet.name || "Unknown pet"%>
    <% end %>
  </div>
</div>
<div class="msg-container-wrapper">
  <%= turbo_stream_from "chat_#{@chat.id}" %>
  <%# Subscribes the container to the turbostream that checks for new messages  %>
  <div
  class="msg-container"
  id="chat-messages"
  data-controller="scroll messages"
  data-viewer-id="<%= current_user.id %>"
  data-pet-photo-url="<%= url_for(@chat.pet.photo) %>"
  data-vet-photo-url="<%= url_for(@chat.vet.photo) %>">
    <%# data-controller adds controllers for both "scroll" and "messages" %>
    <%= render @messages, viewer_id: current_user.id %>
    <%# Renders the messages partial %>
    <div class="chat-bottom"> </div>
  </div>
  <% if @friendship.accepted == true %>
    <%= form_with model: [@user, @chat, @message],
      html: { multipart: true },
      data: { controller: "file-preview message-guard" } do |f| %>
      <%= f.text_area :contents, data:{
        message_guard_target: "text",
        action: "input->message-guard#check"
        } %>
      <%= f.file_field :file, id: "file-upload", class: "file-input-hidden",
        data: {
          action: "change->file-preview#show",
          file_preview_target: "input"
          }%>
      <div class="row justify-content-between">
        <div class="col-10 align-items-center">
          <label for="file-upload" class="paperclip-btn">
            <i class="fa-solid fa-paperclip"></i>
          </label>
          <span class="file-name" data-file-preview-target="name"></span>
          <button type="button" class="btn btn-sm p-0 d-none" data-action="click->file-preview#remove" data-file-preview-target="remove">
            X
          </button>
        </div>
        <div class="col-2">
          <button type="submit" class="send-btn"
            aria-label="Send message" data-message-guard-target="send">
            <i class="fa-solid fa-arrow-up"></i>
          </button>
        </div>
      </div>
    <% end %>
  <% elsif @friendship.accepted == false && @user.role == "owner" %>
    <button>
      I DO SOMETHING TRUST ME
    </button>
  <% else %>
    <%# form for accepting friend request %>
    <%= form_with model: [@user, @friendship] do |f| %>
      <%= f.button name: "friendship[accepted]", value: "false", class: "btn-reject" do %>
        Reject
      <% end %>
      <%= f.button name: "friendship[accepted]", value: "true", class: "btn-accept" do %>
        Accept
      <% end %>
    <% end %>
  <% end %>
</div>
<style>
  /* RIGHT (from me) */
</style>
