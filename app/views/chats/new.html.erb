<div class="chat-page">
  <div class="chat-subnav row">
    <div class="col-1">
      <%= link_to user_chats_path(@user) do %>
        <i class="fa-solid fa-chevron-left"></i>
      <% end %>
    </div>
  </div>
  <%= simple_form_for [@user, @chat],
        url: user_chats_path(@user),
        html: { class: "chat-form", multipart: true },
        data: {
          controller: "file-preview message-guard",
          action: "turbo:submit-start->message-guard#sending turbo:submit-end->message-guard#reset"
          } do |f| %>
    <% if current_user.role == "owner" %>
      <div class="selection">
        <% vets_collection = @clinic_id.present? ? User.joins(:clinic).where(clinics: { id: @clinic_id }) : User.where(role: "vet") %>
        <%= f.input :vet_id,
          collection: vets_collection,
          label_method: ->(vet) { "#{vet.clinic&.clinic_name} (#{vet.name})" },
          value_method: :id,
          include_blank: false %>
        <%= f.input :pet_id,
          collection: @user.pets,
          label_method: :name,
          value_method: :id,
          prompt: "Choose a pet" %>
      </div>
    <% else %>
      <div class="selection">
        <%= f.input :pet_id,
          collection: Pet.all,
          label_method: :name,
          value_method: :id,
          prompt: "Choose a pet" %>
      </div>
    <% end %>
    <!-- messages spacer -->
    <div class="chat-messages"></div>
    <!-- input -->
    <div class="new-msg">
      <%= f.simple_fields_for :messages do |m| %>
        <%= m.text_area :contents,
          placeholder: "Type a message...",
          rows: 2,
          data: {
            message_guard_target: "text",
            action: "input->message-guard#check"
          } %>
        <%= m.file_field :file, id: "file-upload",
          class: "file-input-hidden",
          data: {
            action: "change->file-preview#show",
            file_preview_target: "input"
          } %>
        <div class="row justify-content between">
          <div class="col-10">
            <label for="file-upload" class="paperclip-btn">
              <i class="fa-solid fa-paperclip"></i>
            </label>
            <span class="file-name" data-file-preview-target="name"></span>
            <button type="button"
                class="btn btn-sm p-0 d-none"
                data-action="click->file-preview#remove"
              data-file-preview-target="remove">
              X
            </button>
          </div>
          <div class="col-2">
            <button type="submit" class="send-btn"
                  aria-label="Send message"
                  data-message-guard-target="send">
              <i class="fa-solid fa-arrow-up"></i>
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
</div>
