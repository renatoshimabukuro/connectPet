<div class="pet-show-container">
  <div class="pet-hero-section">
    <% all_pets = [@pet] + @other_pets.to_a %>
    <div class="splide" data-controller="carousel">
      <div class="splide__track">
        <ul class="splide__list">
          <% all_pets.each do |pet| %>
            <li class="splide__slide">
              <%= link_to user_pet_path(@user, pet), class: "avatar-wrapper" do %>
                <% if pet.photo.attached? %>
                  <%= cl_image_tag pet.photo.key, crop: :fill, class: "avatar-img" %>
                <% else %>
                  <div class="avatar-img placeholder-show">
                    <i class="fa-solid fa-paw"></i>
                  </div>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
      <div class="splide__arrows">
        <button class="splide__arrow splide__arrow--prev custom-carousel-control prev" type="button"></button>
        <button class="splide__arrow splide__arrow--next custom-carousel-control next" type="button"></button>
      </div>
    </div>
  </div>
  <div class="text-center">
    <h1 class="pet-name-title"><%= @pet.name %></h1>
    <p class="pet-subtitle">
      <%= @pet.species.name %> • <%= @pet.breed.name %> • <%= @pet.gender %><% if @pet.gender.capitalize == 'Male' %><i class="fa-solid fa-mars"></i><% else %><i class="fa-solid fa-venus"></i><% end %>
      <br>
      <%= @pet.fixed ? (@pet.gender == 'Male' ? 'Neutered' : 'Spayed') : 'Intact' %>
    </p>
    <div class="vital-grid">
      <%# DOB %>
      <div class="vital-card">
        <%= link_to edit_user_pet_path(@user, @pet, field: 'dob'), data: { turbo_frame: "modal" } do %>
          <i class="fa-solid fa-pencil edit-pencil"></i>
        <% end %>
        <div class="pet-show-icon-wrapper">
          <i class="fa-solid fa-calendar-days card-icon"></i>
        </div>
        <span class="card-label">Date of Birth:</span>
        <span class="card-value"><%= @pet.dob.strftime("%Y/%m/%d") if @pet.dob %></span>
      </div>
      <%# Vaccines %>
      <% current_vaccine = @pet.pet_vaccs
                       .where("expires_on >= ?", Date.current)
                       .order(:expires_on)
                       .first %>
      <%= link_to user_pet_pet_vaccs_path(@user, @pet),
      class: "text-decoration-none text-reset" do %>
        <div class="vital-card">
          <div class="pet-show-icon-wrapper">
            <i class="fa-solid fa-syringe card-icon"></i>
          </div>
          <span class="card-label">Vaccines:</span>
          <span class="card-value">
            <% if current_vaccine.present? %>
              <%= truncate(current_vaccine.vaccine_definition.name, length: 15, separator: ' ', omission: '') %>
            <% else %>
              None active
            <% end %>
          </span>
        </div>
      <% end %>
      <%# Microchip %>
      <div class="vital-card">
        <%= link_to edit_user_pet_path(@user, @pet, field: 'microchip'), data: { turbo_frame: "modal" } do %>
          <i class="fa-solid fa-pencil edit-pencil"></i>
        <% end %>
        <div class="pet-show-icon-wrapper">
          <i class="fa-solid fa-microchip card-icon"></i>
        </div>
        <span class="card-label">Microchip:</span>
        <%# <span class="card-value"><%= @pet.microchip.presence || "None" %></span>
      <span class="card-value"><%= truncate(@pet.microchip.gsub(/\S/, '*'), length: 15) %> </span>
    </div>
    <%# Weight %>
    <div class="vital-card">
      <%= link_to edit_user_pet_path(@user, @pet, field: 'weight'), data: { turbo_frame: "modal" } do %>
        <i class="fa-solid fa-pencil edit-pencil"></i>
      <% end %>
      <div class="pet-show-icon-wrapper">
        <i class="fa-solid fa-weight-hanging card-icon"></i>
      </div>
      <span class="card-label">Weight:</span>
      <span class="card-value"><%= @pet.weight %> kg</span>
    </div>
    <%# Medications %>
    <div class="vital-card">
      <%= link_to edit_user_pet_path(@user, @pet, field: 'current_meds'), data: { turbo_frame: "modal" } do %>
        <i class="fa-solid fa-pencil edit-pencil"></i>
      <% end %>
      <div class="pet-show-icon-wrapper">
        <i class="fa-solid fa-capsules card-icon"></i>
      </div>
      <span class="card-label">Medications:</span>
      <span class="card-value"><%= truncate(@pet.current_meds.presence, length: 15, separator: ' ') || "None" %></span>
    </div>
    <%# Notes %>
    <div class="vital-card">
      <%= link_to edit_user_pet_path(@user, @pet, field: 'notes'), data: { turbo_frame: "modal" } do %>
        <i class="fa-solid fa-pencil edit-pencil"></i>
      <% end %>
      <div class="pet-show-icon-wrapper">
        <i class="fa-solid fa-note-sticky card-icon"></i>
      </div>
      <span class="card-label">Notes:</span>
      <span class="card-value"><%= truncate(@pet.notes.presence, length: 15, separator: ' ') || "No notes" %></span>
    </div>
  </div>
  <div class="pet-actions-footer">
    <%= link_to user_pet_logs_path(@user, @pet), class: "btn-log", data: { turbo_frame: "_top" } do %>
      <i class="fa-solid fa-book-open"></i> View history
    <% end %>
    <%= link_to new_user_pet_log_path(@user, @pet), class: "btn-log", data: { turbo_frame: "_top" } do %>
      <i class="fa-solid fa-plus"></i> Today's info
    <% end %>
  </div>
</div>
</div>
