<div class="pet-index-container">
  <h1 class="index-title"><%= @title %></h1>
  <div class="pet-cards-wrapper">
    <% @pets.each do |pet| %>
      <%# Defining card content to not repeat %>
      <% card_content = capture do %>
        <div class="card-index">
          <% if pet&.photo&.attached? %>
            <%= cl_image_tag pet.photo.key, crop: :fill, class: "avatar-index-large" %>
          <% else %>
            <div class="avatar-index-large placeholder">
              <i class="fa-solid fa-paw"></i>
            </div>
          <% end %>
          <div class="name-section-wrapper">
            <h2 class="pet-name-index"><%= pet.name %></h2>
            <% case pet.name %>
            <% when "Raye"%>
              <p> Tracking: </p>
              <div class="tracked_attributes">
                <i class="iconify" data-icon="mdi:silverware-fork-knife" style="font-size: 1em; color: white;"></i>
                <i class="iconify" data-icon="streamline:smiley-nauseas-solid" style="font-size: 1em; color: white;"></i>
                <i class="iconify" data-icon="mdi:toilet" style="font-size: 1em; color: white;"></i>
              </div>
            <% when "Percy"%>
              <p> Tracking: </p>
              <div class="tracked_attributes">
                <i class="iconify" data-icon="mdi:silverware-fork-knife" style="font-size: 1em; color: white;"></i>
                <i class="iconify" data-icon="streamline:smiley-nauseas-solid" style="font-size: 1em; color: white;"></i>
                <i class="iconify" data-icon="mdi:toilet" style="font-size: 1em; color: white;"></i>
              </div>
            <% when "Cory"%>
              <p> Tracking: </p>
              <div class="tracked_attributes">
                <i class="iconify" data-icon="mdi:silverware-fork-knife" style="font-size: 1em; color: white;"></i>
                <i class="iconify" data-icon="mdi:toilet" style="font-size: 1em; color: white;"></i>
              </div>
            <% end %>
          </div>
          <% if @title == "Your Pets!" %>
            <i class="fa-solid fa-calendar-plus"
               onclick="event.preventDefault(); window.location.href='<%= new_user_pet_log_path(current_user, pet) %>';">
            </i>
          <% elsif @title == "Heart Gallery" %>
            <%# Only shows button to restore if in the Heart Gallery %>
            <%= button_to unarchive_user_pet_path(current_user, pet),
              method: :patch,
              class: "btn-reset-icon",
              style: "background-color: #A3B899; border: none; border-radius: 5px; padding: 5px; cursor: pointer;",
              form: { onclick: "event.stopPropagation();", style: "display:inline; background-color: #A3B899; border: none; border-radius: 5px; padding: 5px; cursor: pointer;" },
              data: { turbo_confirm: "Restore #{pet.name}?" } do %>
              <i class="fa-solid fa-arrow-rotate-left"></i>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <%# If the pet is not in the heart gallery, there is a link to profile %>
      <% if @title == "Your Pets!" %>
        <%= link_to user_pet_path(current_user, pet), class: "card-index-link" do %>
          <%= card_content %>
        <% end %>
      <% else %>
        <%= card_content %>
      <% end %>
    <% end %>
  </div>

  <%# Users connections %>
  <% if @title == "Your Pets!" && @my_clinics.any? %>
    <h3 class="mt-4">Your Connected Veterinarians</h3>

    <% @my_clinics.each do |clinic| %>
      <div class="vet-card-custom">
        <% if clinic&.photo&.attached? %>
          <%= cl_image_tag clinic.photo.key, crop: :fill, class: "avatar-index-large" %>
        <% else %>
          <div class="avatar-index-large placeholder">
            <i class="fa-regular fa-hospital"></i>
          </div>
        <% end %>
        <div class="name-section-wrapper">
          <%= link_to clinic_path(clinic), class: "card-index-link" do %>
            <div class="vet-name-index"><%= clinic.clinic_name %> </div>
          <% end %>
          <div class="vet-languages">Pets: <%= clinic.species.join(", ") %></div>
          <div class="vet-languages">Languages: <%= clinic.languages.join(", ") %></div>
          <div class="vet-languages">Specialties: <%= clinic.field.join(", ") %></div>
          <div class="vet-languages">Address: <%= clinic.user.address %></div>
        </div>
        <i class="fa-solid fa-comment"
           onclick="event.preventDefault();
           window.location.href='<%= new_user_chat_path(current_user) %>';">
        </i>
      </div>
    <% end %>
  <% end %>
  <%= link_to "Search for Vets", clinics_path, class: 'btn btn-danger text-white' %>
  <%= f.button :submit, "Save", class: "btn btn-primary" %>
</div>
<style>
  p {
    margin-bottom: 0px;
  }
</style>
