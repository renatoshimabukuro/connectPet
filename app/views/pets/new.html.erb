<div class="container mt-3">
  <%= simple_form_for [@user, @pet],
        html: { multipart: true },
        data: { controller: "form-steps", form_steps_current_value: 0 } do |f| %>
    <!-- Progress bar -->
    <div class="progress">
      <div class="progress-bar" data-form-steps-target="progressBar"></div>
    </div>
    <!-- STEP 1 -->
    <div data-form-steps-target="step">
      <%= render "step_navigation", classes: "mt-2 mb-3 d-md-none", show_back: false, show_continue: true %>
      <h2>New pet: Basic information</h2>
      <div data-controller="avatar-preview">
        <div class="avatar-upload mx-auto <%= 'has-image' if f.object.photo.present? %>"
       data-avatar-preview-target="preview"
       data-action="click->avatar-preview#openFilePicker">
          <% if f.object.photo.present? %>
            <%= image_tag f.object.photo, alt: "Pet photo preview" %>
          <% end %>
        </div>
        <%= f.input :photo,
              as: :file,
              label: false,
              input_html: {
                class: "d-none",
                accept: "image/*",
                capture: "environment",
                data: {
                  avatar_preview_target: "input",
                  action: "change->avatar-preview#previewImage"
                }
              } %>
      </div>
      <%= f.input :name %>
      <%= f.input :gender, as: :radio_buttons, collection: ["male", "female"], wrapper_html: { class: "row "},
                item_wrapper_class: "col-6 mb-2",
                input_html: { class: "me-2" } %>
      <%= f.input :dob, as: :date, label: "Date of birth", start_year: Date.current.year - 30, end_year: Date.current.year %>
      <%= render "step_navigation", classes: "mt-2 d-none d-md-flex", show_back: false, show_continue: true %>
    </div>
    <!-- STEP 2 -->
    <div data-form-steps-target="step" class="d-none">
      <%= render "step_navigation", classes: "mt-2 mb-3 d-md-none", show_back: true, show_continue: true %>
      <h2>New pet: Species</h2>
      <div class="species-grid">
        <% Species.all.each do |species| %>
          <label class="species-card">
            <%= f.radio_button :species_id, species.id,
              data: { action: "change->form-steps#filterBreeds", species_id: species.id } %>
            <div class="card-content">
              <div class="icon"><i class="<%= species.icon %>"></i></div>
              <div class="name"><%= species.name %></div>
            </div>
          </label>
        <% end %>
      </div>
      <%= render "step_navigation", classes: "mt-2 d-none d-md-flex gap-2", show_back: true, show_continue: true %>
    </div>
    <!-- STEP 3 -->
    <div data-form-steps-target="step" class="d-none">
      <%= render "step_navigation", classes: "mt-2 mb-3 d-md-none", show_back: true, show_continue: true %>
      <h2>New pet: Breed</h2>
      <div class="species-grid" data-form-steps-target="breedGrid"></div>
      <%= render "step_navigation", classes: "mt-2 d-none d-md-flex gap-2", show_back: true, show_continue: true %>
    </div>
    <!-- STEP 4 -->
    <div data-form-steps-target="step" class="d-none ">
      <%= render "step_navigation", classes: "mt-2 mb-3 d-md-none", show_back: true, show_continue: true %>
      <h2>New pet: Security</h2>
      <%= f.input :fixed, as: :boolean, label: "Neutered/spayed" %>
      <%= f.input :microchip, label: "Microchip number" %>
      <%= f.simple_fields_for :pet_vaccs do |vacc_form| %>
        <%= vacc_form.input :vaccine_definition_id %>
        <%= vacc_form.input :date_administered %>
      <% end %>
      <%= render "step_navigation", classes: "mt-2 d-none d-md-flex gap-2", show_back: true, show_continue: true %>
    </div>
    <!-- STEP 5 -->
    <div data-form-steps-target="step" class="d-none">
      <%= render "step_navigation", classes: "mt-2 mb-3 d-md-none", show_back: true, show_continue: false %>
      <h2>New pet: Health</h2>
      <div class="weight-field">
        <%= f.input :weight, label: "Weight", input_html: { step: 0.1 } %>
        <span class="suffix">kg</span>
      </div>
      <%= f.input :notes, placeholder: "Allergies, preferences, etc." %>
      <%= render "step_navigation", classes: "mt-2 d-none d-md-flex gap-2", show_back: true, show_continue: false %>
      <%= f.button :submit, "Create Pet" %>
    </div>
  <% end %>
</div>
