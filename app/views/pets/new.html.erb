<div class="container mt-3">
  <%= simple_form_for [@user, @pet],
        html: { multipart: true },
        data: { controller: "form-steps", form_steps_current_value: 0 } do |f| %>
    <!-- Progress bar -->
    <div class="progress">
      <div class="progress-bar" data-form-steps-target="progressBar"></div>
    </div>
    <!-- STEP 1 -->
    <div data-form-steps-target="step">
      <h2>Add a pet</h2>
      <%= f.input :picture, as: :file, label: "Profile Picture" %>
      <%= f.input :name %>
      <%= f.input :gender, as: :radio_buttons, collection: ["male", "female"], wrapper_html: { class: "row "},
                item_wrapper_class: "col-6 mb-2",
                input_html: { class: "me-2" } %>
      <%= f.input :dob, as: :date, label: "Date of birth", start_year: Date.current.year - 30, end_year: Date.current.year %>
      <button type="button" data-action="form-steps#next" class="btn">Continue</button>
    </div>
    <!-- STEP 2 -->
    <div data-form-steps-target="step" class="hidden">
      <h3>Species:</h3>
      <div class="species-grid">
        <% Species.all.each do |species| %>
          <label class="species-card">
            <%= f.radio_button :species_id, species.id,
              data: { action: "change->form-steps#filterBreeds", species_id: species.id } %>
            <div class="card-content">
              <div class="icon"><i class="<%= species.icon %>"></i></div>
              <div class="name"><%= species.name %></div>
            </div>
          </label>
        <% end %>
      </div>
      <div class="mt-2">
        <button type="button" data-action="form-steps#prev" class="btn"> Back </button>
        <button type="button" data-action="form-steps#next" class="btn"> Continue </button>
      </div>
    </div>
    <!-- STEP 3 -->
    <!-- STEP 3 -->
    <div data-form-steps-target="step" class="hidden">
      <h3>Breed:</h3>
      <div
    class="species-grid"
    data-form-steps-target="breedGrid"
  ></div>
      <button
    type="button"
    class="btn d-none"
    data-action="form-steps#prevBreedPage"
    data-form-steps-target="breedPrevButton"
  >
        Previous breeds
      </button>
      <button
    type="button"
    class="btn d-none"
    data-action="form-steps#nextBreedPage"
    data-form-steps-target="breedNextButton"
  >
        More breeds
      </button>
      <div class="mt-2">
        <button
      type="button"
      data-action="form-steps#prev"
      class="btn"
    >
          Back
        </button>
        <button
      type="button"
      data-action="form-steps#next"
      class="btn"
    >
          Continue
        </button>
      </div>
    </div>
    <!-- STEP 4 -->
    <div data-form-steps-target="step" class="hidden">
      <h3>Details:</h3>
      <%= f.input :fixed, as: :boolean %>
      <div class="weight-field">
        <%= f.input :weight, label: "Weight", input_html: { step: 0.1 } %>
        <span class="suffix">kg</span>
      </div>
      <%= f.input :microchip %>
      <%= f.input :vacc_status,
        as: :check_boxes,
        collection: ["Vaccinated", "Rabies", "Other"] %>
      <div class="mt-2">
        <button type="button" data-action="form-steps#prev" class="btn"> Back </button>
        <button type="button" data-action="form-steps#next" class="btn"> Continue </button>
      </div>
    </div>
    <!-- STEP 5 -->
    <div data-form-steps-target="step" class="hidden">
      <h3>Other</h3>
      <%= f.input :notes %>
      <button type="button" data-action="form-steps#prev" class="btn"> Back </button>
      <%= f.button :submit, "Create Pet" %>
    </div>
  <% end %>
</div>
<style>
  .hidden {
    display: none;
  }

  .progress {
    width: 100%;
    height: 8px;
    background: #eee;
    margin-bottom: 20px;
    border-radius: 4px;
  }

  .progress-bar {
    height: 100%;
    width: 0%;
    background: #4caf50;
    transition: width 0.3s ease;
  }
  .species-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: 0.75rem;
  }

  .species-card {
    cursor: pointer;
    height: 9rem;
  }

  .species-card input {
    display: none;
  }

  .species-card .card-content {
    height: 100%;
    border: 2px solid #ddd;
    border-radius: 0.625rem;
    padding: 0.75rem;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;

    transition: 0.2s;
  }

  .card-content .icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .card-content .name {
    min-height: 2.5rem;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 0.875rem;
      line-height: 1.2;
  }

  /* Selected state */
  .species-card input:checked + .card-content {
  border-color: #4caf50;
  background: #f0fff4;
  }

  .species-card input:checked + .card-content {
  border-color: #4caf50;
  background: #f0fff4;
  }

  .weight-field {
  position: relative;
  }

  .weight-field input {
  padding-right: 35px;
  }

  .weight-field .suffix {
  position: absolute;
  right: 10px;
  top: 40px;
  color: #888;
  font-size: 14px;
  }
</style>
