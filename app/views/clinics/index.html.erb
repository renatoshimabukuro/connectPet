<div class="clinic-index-container">
  <h1 class="index-title">Clinics</h1>


    <%= form_tag clinics_path, method: :get, class: "d-flex my-3" do %>
      <%= label_tag :query, "Search veterinarians", class: "visually-hidden" %>
      <%= text_field_tag :query,
          params[:query],
          class: "form-control",
          placeholder: "Type a keyword"
      %>
      <%= submit_tag "Search", name: "", class: "btn btn-primary" %>
    <% end %>

    <% if @clinics.empty? && params[:query].present? %>
      <div class="alert alert-warning mt-3">
        <i class="fa-solid fa-circle-exclamation"></i>
        No results found for "<strong><%= params[:query] %></strong>".
      </div>
    <% end %>



  <div class="vet-cards-wrapper">
    <% @clinics.each do |clinic| %>
      <%= link_to clinic_path(clinic), class: "card-index-link h-100" do %>
        <div class="card-index">
          <%# Protecting view from nil data %>
          <% if clinic&.photo&.attached? %>
            <%= cl_image_tag clinic.photo.key, crop: :fill, class: "avatar-index-large" %>
          <% else %>
            <div class="avatar-index-large placeholder">
              <i class="fa-regular fa-hospital"></i>
            </div>
          <% end %>
          <div class="name-section-wrapper">
            <h2 class="vet-name-index"><%= clinic.clinic_name %></h2>
          </div>

        </div>
      <% end %>
    <% end %>
  </div>


</div>
