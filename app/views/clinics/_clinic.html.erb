<div class="clinic-container">
  <h2 class="clinic-name mt-2 text-center"><%= @clinic.clinic_name %></h2>

  <% if @clinic.photo.attached? %>
    <%= cl_image_tag @clinic.photo.key, crop: :fill, class: "img-fluid w-100 clinic-banner mb-4" %>
  <% end %>

  <div class="row g-3 px-3"> <%# space between cards %>

    <div class="col-12">
      <div class="vital-card px-3 py-3">
        <div class="card-header-row">
          <div class="card-label">We care for</div>
          <i class="fa-solid fa-paw card-icon-inline"></i>
        </div>
        <div class="card-value d-flex flex-wrap gap-2 mt-2">
          <% @clinic.species.each do |specie| %>
            <span class="pets-languages-fields-tag"><%= specie %></span>
          <% end %>
        </div>
      </div>
    </div>


    <div class="col-12">
      <div class="vital-card px-3 py-3">
        <div class="card-header-row">
          <div class="card-label">Specialties</div>
          <i class="fa-solid fa-stethoscope card-icon"></i>
        </div>
        <div class="card-value d-flex flex-wrap gap-2 mt-2">
          <% @clinic.field.each do |field| %>
            <span class="pets-languages-fields-tag"><%= field %></span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="vital-card px-3 py-3">
        <div class="card-header-row">
          <div class="card-label">Languages</div>
          <i class="fa-solid fa-language card-icon-inline"></i>
        </div>
        <div class="card-value d-flex flex-wrap gap-2 mt-2">
          <% @clinic.languages.each do |lang| %>
            <span class="pets-languages-fields-tag"><%= lang %></span>
          <% end %>
        </div>
      </div>
    </div>

        <div class="col-12">
      <div class="vital-card px-3 py-3" style="min-height: 100px;">
        <div class="card-header-row">
          <div class="card-label">Contact</div>
          <i class="fa-regular fa-envelope"></i>
        </div>
        <div class="card-value"><%= @clinic.contact %></div>
      </div>
    </div>

    <div class="col-12">
      <div class="vital-card px-3 py-3" style="min-height: 100px;">
        <div class="card-header-row">
          <div class="card-label">Address</div>
          <i class="fa-solid fa-location-dot card-icon"></i>
        </div>
        <div class="card-value"><%= @clinic.user.address %></div>
      </div>
    </div>

  </div>
</div>
