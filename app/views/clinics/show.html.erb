<div class="container pb-3">
  <%= render @clinic %>
  <div class="d-flex justify-content-between align-items-center w-100 mt-4 px-2">
    <%= link_to "Back to clinics", clinics_path, class: "btn-log" %>
    <% if user_signed_in? && current_user.role == "owner" %>
      <%= link_to new_user_chat_path(current_user, vet_id: @clinic.user_id, clinic_id: @clinic.id), class: "btn-log", data: { turbo_frame: "_top" } do %>
        <i class="fa-solid fa-plus"></i> Add Vet
      <% end %>
    <% end %>
  </div>
</div>
