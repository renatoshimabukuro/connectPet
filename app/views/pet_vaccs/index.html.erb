<div class="logs-index-container">
  <div class="logs-index-wrapper">
    <div class="logs-index-headbar">
      <div class="row pt-2">
        <div class="col-10">
          <h1 class="ms-4"><%= @pet.name %>'s Vaccinations</h1>
        </div>
        <div class="col-2">
          <%= link_to new_user_pet_pet_vacc_path(@user, @pet),
                class: "text-dark" do %>
            <i class="fa-solid fa-plus" style="font-size: 30px"></i>
          <% end %>
        </div>
      </div>
    </div>
    <div class="logs-all">
      <% if @pet_vaccs.any? %>
        <%= render partial: "pet_vacc",
              collection: @pet_vaccs,
              as: :pet_vacc %>
      <% else %>
        <div class="text-center mt-4">
          <p>No vaccinations recorded yet.</p>
          <%= link_to "Add First Vaccination",
                new_user_pet_pet_vacc_path(@user, @pet),
                class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
