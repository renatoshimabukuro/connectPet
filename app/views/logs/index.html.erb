<div class="pet-index-container">
  <div class="row">
    <div class="col-10">
      <h1><%= @pet.name %>'s History</h1>
    </div>
    <div class="col-2">
      <%= link_to new_user_pet_log_path(@user, @pet) do %>
        <i class="fa-solid fa-plus" style="font-size: 30px"></i>
      <% end %>
    </div>
  </div>
  <%# End of title here, start of search function %>
  <div class="mb-3 mt-3">
    <table>
      <th> <%= multi_sortable("date","Date") %> </th>
      <th> <%= multi_sortable("attr1_value", "#{@pet.attr1}") %> </th>
      <% if @pet.attr2 %>
        <th> <%= multi_sortable("attr2_value", "#{@pet.attr2}") %> </th>
      <% end %>
      <% if @pet.attr3 %>
        <th> <%= multi_sortable("attr3_value", "#{@pet.attr3}") %> </th>
      <% end %>
      <% if @pet.attr4 %>
        <th> <%= multi_sortable("attr4_value", "#{@pet.attr4}") %> </th>
      <% end %>
      <% if @pet.attr5 %>
        <th> <%= multi_sortable("attr5_value", "#{@pet.attr5}") %> </th>
      <% end %>
      <th> <%= link_to user_pet_logs_path(@user, @pet) do %>
          <i class="fa-solid fa-arrow-rotate-left"></i>
        <% end %>
      </th>
    </table>
  </div>
  <%# End of search function here, start of logs %>
  <div id="loading-overlay">
    <div class="loader"></div>
    <p style="margin-top: 15px; font-weight: bold;">Gemini is analyzing your data...</p>
  </div>
  <div class="logs-all mx-auto">
    <% if @logs.any? %>
      <% @logs.each do |log| %>
        <div class="card-logs mb-2 mx-auto">
          <%= link_to "Date: #{log.date}", user_pet_log_path(@user, @pet, log) %>
          <table class="text-center">
            <tr>
              <%# First heading %>
              <th>
                <i class="iconify" data-icon="mdi:silverware-fork-knife" style="font-size: 1em;"></i>
              </th>
              <%# Second heading %>
              <% if @pet.name == "Raye" || @pet.name == "Percy" %>
                <th>
                  <i class="iconify" data-icon="streamline:smiley-nauseas-solid" style="font-size: 1em;"></i>
                </th>
              <% elsif @pet.name == "Cory" %>
                <th>
                  <i class="iconify" data-icon="mdi:toilet" style="font-size: 1em;"></i>
                </th>
              <% elsif log.attr2 %>
                <th>
                  <%= log.attr2 %>
                </th>
              <% end %>
              <%# Third heading %>
              <% if @pet.name == "Raye" || @pet.name == "Percy" %>
                <th>
                  <i class="iconify" data-icon="mdi:toilet" style="font-size: 1em;"></i>
                </th>
              <% elsif log.attr3 %>
                <th>
                  <%= log.attr3 %>
                </th>
              <% end %>
              <%# Fourth heading %>
              <% if log.attr4 %>
                <th>
                  <%= log.attr4 %>
                </th>
              <% end %>
              <%# Fifth heading %>
              <% if log.attr5 %>
                <th>
                  <%= log.attr5 %>
                </th>
              <% end %>
            </tr>
            <tr>
              <% if log.attr1 %>
                <td> <%= log.attr1_value %> </td>
              <% end %>
              <% if log.attr2 %>
                <td> <%= log.attr2_value %> </td>
              <% end %>
              <% if log.attr3 %>
                <td> <%= log.attr3_value %> </td>
              <% end %>
              <% if log.attr4 %>
                <td> <%= log.attr4_value %> </td>
              <% end %>
              <% if log.attr5 %>
                <td> <%= log.attr5_value %> </td>
              <% end %>
            </tr>
            <tr>
              <% if log.attr1_memo && log.attr1_memo != "" %>
                <td><i class="iconify" data-icon="material-symbols:export-notes-outline" style="font-size: 20px;"></i></td>
              <% end %>
              <% if log.attr2_memo && log.attr2_memo != "" %>
                <td><i class="iconify" data-icon="material-symbols:export-notes-outline" style="font-size: 20px;"></i></td>
              <% end %>
              <% if log.attr3_memo && log.attr3_memo != "" %>
                <td><i class="iconify" data-icon="material-symbols:export-notes-outline" style="font-size: 20px;"></i></td>
              <% end %>
              <% if log.attr4_memo && log.attr4_memo != "" %>
                <td><i class="iconify" data-icon="material-symbols:export-notes-outline" style="font-size: 20px;"></i></td>
              <% end %>
              <% if log.attr5_memo && log.attr5_memo != "" %>
                <td><i class="iconify" data-icon="material-symbols:export-notes-outline" style="font-size: 20px;"></i></td>
              <% end %>
            </tr>
          </table>
        </div>
      <% end %>
    <% else %>
      <p>No logs yet.</p>
    <% end %>
  </div>
  <div class="export-logs-card">
    <%= form_with url: export_user_pet_logs_path(format: :pdf), method: :post, html: { onsubmit: "const overlay = document.getElementById('loading-overlay'); overlay.style.visibility = 'visible'; setTimeout(() => {overlay.style.visibility = 'hidden'; }, 30000);" } do |f| %>
      <div class="date-range-selector">
        <%= f.label :start_date, "Start Date:" %>
        <%= f.date_field :start_date, id: "start-date", required: true %>
      </div>
      <div class="date-range-selector">
        <%= f.label :end_date, "End Date:" %>
        <%= f.date_field :end_date, id: "end-date", required: true, max: Date.today %>
      </div>
      <div class="language-selector">
        <%= f.label :language, "Language:" %>
        <%= f.select :language, ["English", "日本語", "Português"]%>
      </div>
      <%= f.submit "Export Data"%>
    <% end %>
  </div>
</div>
<style>
  .sort-none {
    border: 2px solid #666;
    border-radius: 8px;
    padding: 2px;
    color: #666;
    text-decoration: none;
    margin-right: 5px;
  }

  .sort-asc {
    border: 2px solid #2a7ae2;
    border-radius: 8px;
    padding: 2px;
    color: #2a7ae2;
    font-weight: bold;
    margin-right: 5px;
  }

  .sort-desc {
    border: 2px solid #e5533d;
    border-radius: 8px;
    padding: 2px;
    color: #e5533d;
    font-weight: bold;
    margin-right: 5px;
  }

  .card-logs{
    /* border-radius: 8px;
    border: 2px solid black;
    width: 70%;
    padding: 2px; */
    background-color: #a3b899;
    border-radius: 22px;
    padding: 8px;
    position: relative;
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* min-height: 125px; */
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.06);
    width: 80%;
  }

  .logs-all{
    width: 100%;
  }

  .export-logs-card {
    width: 100%;
    bottom: 0;

    form {
      background: none;

      input, select {
        margin-left: 5%;
      }
    }
  }
</style>
