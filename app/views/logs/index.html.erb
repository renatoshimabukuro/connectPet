<div class="logs-index-container">
  <div class="logs-index-wrapper">
    <div class="logs-index-headbar">
      <div class="row">
        <div class="col-10">
          <h1 class="ms-4"><%= @pet.name %>'s History</h1>
        </div>
        <div class="col-2">
          <%= link_to new_user_pet_log_path(@user, @pet) do %>
            <i class="fa-solid fa-plus" style="font-size: 30px"></i>
          <% end %>
        </div>
      </div>
      <%# End of title here, start of search function %>
      <div class="my-3">
        <table>
          <th><%= multi_sortable("date", "Date") %></th>
          <% @pet.pet_attributes.includes(:attribute_definition).each do |pa| %>
            <th> <%= pa.attribute_definition.name %> </th>
          <% end %>
          <th>
            <%= link_to user_pet_logs_path(@user, @pet) do %>
              <i class="fa-solid fa-arrow-rotate-left"></i>
            <% end %>
          </th>
        </table>
      </div>
    </div>
    <%# End of search function here, start of loader %>
    <div id="loading-overlay">
      <div class="loader"></div>
      <p style="margin-top: 15px; font-weight: bold;">connectPet is analyzing your data...</p>
    </div>
    <%# End of loader, start of all logs/ filtered logs %>
    <div class="logs-all">
      <% if @logs.any? %>
        <% @logs.each do |log| %>
          <div class="card-logs mb-2 mx-auto <%= "card-log-today" if log.date === Date.today%>">
            <%= link_to user_pet_log_path(@user, @pet, log) do %>
              <div class="row">
                <div class="col-9 ms-2">
                  <p> <%= log.date == Date.today ? "Today" : log.date %> </p>
                </div>
                <div class="col-2">
                  <%= button_to user_pet_log_path(@user, @pet, log), method: :delete,
                    class: "btn btn-link p-0 log-trash",
                    data: { turbo_confirm: "Delete this log?" } do %>
                    <i class="fa-solid fa-trash"></i>
                  <% end %>
                </div>
              </div>
              ---------------
              <table class="text-center">
                <tr>
                  <% @pet.pet_attributes.each do |pa| %>
                    <th>
                      <%= pa.attribute_definition.name %>
                    </th>
                  <% end %>
                </tr>
                <% reactions = ["fa-face-tired", "fa-face-frown", "fa-face-meh", "fa-face-smile", "fa-face-grin-wide"] %>
                <tr>
                  <% @pet.pet_attributes.each do |pa| %>
                    <% lv = log.log_values.find { |v| v.pet_attribute_id == pa.id } %>
                      <td>
                        <% if lv.present? %>
                          <% if pa.attribute_definition.range? && lv.range_value.present? %>
                            <i class="fa-regular <%= reactions[lv.range_value - 1] %>"></i>
                          <% elsif pa.attribute_definition.boolean? && !lv.boolean_value.nil? %>
                            <% if lv.boolean_value %>
                              ✅
                            <% else %>
                              ❌
                            <% end %>
                          <% end %>
                          <% if lv.memo.present? %>
                            <i class="iconify"
                              data-icon="material-symbols:export-notes-outline"
                              style="font-size: 1rem;"></i>
                          <% end %>
                        <% end %>
                      </td>
                    <% end %>
                  </tr>
                  <%#  %>
                  <%#  %>
                  <%#  %>
                </table>
                <%# First heading %>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p>No logs yet.</p>
        <% end %>
      </div>
      <%# Exporting logs %>
      <div class="export-logs-card">
        <%= form_with url: export_user_pet_logs_path(format: :pdf), method: :post, html: { onsubmit: "const overlay = document.getElementById('loading-overlay'); overlay.style.visibility = 'visible'; setTimeout(() => {overlay.style.visibility = 'hidden'; }, 30000);" } do |f| %>
          <div class="row">
            <div class="date-range-selector col-6">
              <%= f.label :start_date, "Start Date:" %>
              <%= f.date_field :start_date, id: "start-date", required: true, value: (Date.today - 7.days) %>
            </div>
            <div class="date-range-selector col-6">
              <%= f.label :end_date, "End Date:" %>
              <%= f.date_field :end_date, id: "end-date", required: true, max: Date.today, value: Date.today %>
            </div>
          </div>
          <div class="row align-items-end">
            <div class="language-selector col-6">
              <%= f.label :language, "Language:" %>
              <%= f.select :language, ["English", "日本語", "Português"]%>
            </div>
            <div class="col-6">
              <%= f.submit "Export Data", class: "export-logs-submit"%>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
