<div class="logs-index-container">
  <div class="logs-index-wrapper">
    <div class="logs-index-headbar">
      <div class="row">
        <div class="col-10">
          <h1 class="ms-4"><%= @pet.name %>'s History</h1>
        </div>
        <div class="col-2">
          <%= link_to new_user_pet_log_path(@user, @pet) do %>
            <i class="fa-solid fa-plus" style="font-size: 30px"></i>
          <% end %>
        </div>
      </div>
      <%# End of title here, start of search function %>
      <div class="my-3">
        <table>
          <thead>
            <tr>
              <th> <%= multi_sortable("date","Date") %> </th>
              <th> <%= multi_sortable("attr1_value", "#{@pet.attr1}") %> </th>
              <% if @pet.attr2 %>
                <th> <%= multi_sortable("attr2_value", "#{@pet.attr2}") %> </th>
              <% end %>
              <% if @pet.attr3 %>
                <th> <%= multi_sortable("attr3_value", "#{@pet.attr3}") %> </th>
              <% end %>
              <% if @pet.attr4 %>
                <th> <%= multi_sortable("attr4_value", "#{@pet.attr4}") %> </th>
              <% end %>
              <% if @pet.attr5 %>
                <th> <%= multi_sortable("attr5_value", "#{@pet.attr5}") %> </th>
              <% end %>
              <th> <%= link_to user_pet_logs_path(@user, @pet) do %>
                  <i class="fa-solid fa-arrow-rotate-left"></i>
                <% end %>
              </th>
            </tr>
          </thead>
        </table>
      </div>
    </div>
    <%# End of search function here, start of loader %>
    <div id="loading-overlay">
      <div class="loader"></div>
      <p style="margin-top: 15px; font-weight: bold;">connectPet is analyzing your data...</p>
    </div>
    <%# End of loader, start of all logs/ filtered logs %>
    <div class="logs-all">
      <% if @logs.any? %>
        <% @logs.each do |log| %>
          <div class="card-logs mb-2 mx-auto <%= "card-log-today" if log.date === Date.today%>">
            <%= link_to user_pet_log_path(@user, @pet, log) do %>
              <div class="row">
                <div class="col-9 ms-2">
                  <p> <%= log.date == Date.today ? "Today" : log.date %> </p>
                </div>
                <div class="col-2">
                  <%= button_to user_pet_log_path(@user, @pet, log), method: :delete,
                    class: "btn btn-link p-0 log-trash",
                    data: { turbo_confirm: "Delete this log?" } do %>
                    <i class="fa-solid fa-trash"></i>
                  <% end %>
                </div>
              </div>
              <table class="text-center">
                <tr>
                  <%# First heading %>
                  <th>
                    <i class="iconify" data-icon="mdi:silverware-fork-knife" style="font-size: 1.5rem;"></i>
                  </th>
                  <%# Second heading %>
                  <% if @pet.name == "Raye" || @pet.name == "Percy" %>
                    <th>
                      <i class="iconify" data-icon="streamline:smiley-nauseas-remix" style="font-size: 1.5rem;"></i>
                    </th>
                  <% elsif @pet.name == "Cory" %>
                    <th>
                      <i class="iconify" data-icon="mdi:toilet" style="font-size: 1.5rem;"></i>
                    </th>
                  <% elsif log.attr2 %>
                    <th>
                      <%= log.attr2 %>
                    </th>
                  <% end %>
                  <%# Third heading %>
                  <% if @pet.name == "Raye" || @pet.name == "Percy" %>
                    <th>
                      <i class="iconify" data-icon="mdi:toilet" style="font-size: 1.5rem;"></i>
                    </th>
                  <% elsif log.attr3 %>
                    <th>
                      <%= log.attr3 %>
                    </th>
                  <% end %>
                  <%# Fourth heading %>
                  <% if log.attr4 %>
                    <th>
                      <%= log.attr4 %>
                    </th>
                  <% end %>
                  <%# Fifth heading %>
                  <% if log.attr5 %>
                    <th>
                      <%= log.attr5 %>
                    </th>
                  <% end %>
                </tr>
                <%# Adding values %>
                <% reactions = ["fa-face-tired", "fa-face-frown", "fa-face-meh", "fa-face-smile", "fa-face-grin-wide"]%>
                <tr>
                  <% if log.attr1_value.present? %>
                    <% value = log.attr1_value %>
                    <td>
                      <i class="fa-regular <%=reactions[value - 1]%>"></i>
                      <% if log.attr1_memo && log.attr1_memo != "" %>
                        <i class="iconify" data-icon="material-symbols:export-notes-outline" style="font-size: 1rem;"></i>
                      <% end %>
                    </td>
                  <% end %>
                  <% if log.attr2_value.present? %>
                    <% value = log.attr2_value %>
                    <td>
                      <i class="fa-regular <%=reactions[value - 1]%>"></i>
                      <% if log.attr2_memo && log.attr2_memo != "" %>
                        <i class="iconify" data-icon="material-symbols:export-notes-outline" style="font-size: 1rem;"></i>
                      <% end %>
                    </td>
                  <% end %>
                  <% if log.attr3_value.present? %>
                    <% value = log.attr3_value %>
                    <td>
                      <i class="fa-regular <%=reactions[value - 1]%>"></i>
                      <% if log.attr3_memo && log.attr3_memo != "" %>
                        <i class="iconify" data-icon="material-symbols:export-notes-outline" style="font-size: 1rem;"></i>
                      <% end %>
                    </td>
                  <% end %>
                  <% if log.attr4_value.present? %>
                    <% value = log.attr4_value %>
                    <td>
                      <% if log.attr4_memo && log.attr4_memo != "" %>
                        <i class="iconify" data-icon="material-symbols:export-notes-outline" style="font-size: 1rem;"></i>
                      <% end %>
                      <i class="fa-regular <%=reactions[value - 1]%>"></i>
                    </td>
                  <% end %>
                  <% if log.attr5_value.present? %>
                    <% value = log.attr5_value %>
                    <td>
                      <% if log.attr5_memo && log.attr5_memo != "" %>
                        <i class="iconify" data-icon="material-symbols:export-notes-outline" style="font-size: 1rem;"></i>
                      <% end %>
                      <i class="fa-regular <%=reactions[value - 1]%>"></i>
                    </td>
                  <% end %>
                </tr>
              </table>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p>No logs yet.</p>
      <% end %>
    </div>
    <%# Exporting logs %>
    <div class="export-logs-card">
      <%= form_with url: export_user_pet_logs_path(format: :pdf), method: :post, html: { onsubmit: "const overlay = document.getElementById('loading-overlay'); overlay.style.visibility = 'visible'; setTimeout(() => {overlay.style.visibility = 'hidden'; }, 30000);" } do |f| %>
        <div class="row">
          <div class="date-range-selector col-6">
            <%= f.label :start_date, "Start Date:" %>
            <%= f.date_field :start_date, id: "start-date", required: true, value: (Date.today - 7.days) %>
          </div>
          <div class="date-range-selector col-6">
            <%= f.label :end_date, "End Date:" %>
            <%= f.date_field :end_date, id: "end-date", required: true, max: Date.today, value: Date.today %>
          </div>
        </div>
        <div class="row align-items-end">
          <div class="language-selector col-6">
            <%= f.label :language, "Language:" %>
            <%= f.select :language, ["English", "日本語", "Português"]%>
          </div>
          <div class="col-6">
            <%= f.submit "Export Data", class: "export-logs-submit"%>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
