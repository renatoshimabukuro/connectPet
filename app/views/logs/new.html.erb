<% reactions = ["fa-face-tired",
    "fa-face-frown",
    "fa-face-meh",
    "fa-face-smile",
    "fa-face-grin-wide" ]%>
<div class= "pet-show-container">
  <section class="pet-hero-section">
    <div class="avatar-carousel">
      <div class="avatar-secondary"></div>
      <div class="avatar-main">
        <% if @pet.photo.attached? %>
          <%= image_tag @pet.photo, class: "avatar-large", style: "width: 80px; height: 80px; border-radius: 50%; object-fit: cover;" %>
        <% else %>
          <i class="fa-solid fa-paw" style="font-size: 80px; color: rgba(255,255,255,0.5);"></i>
        <% end %>
      </div>
      <div class="avatar-secondary"></div>
    </div>
    <h1> Hello, <%= @pet.name %></h1>
    <h2 class="mt-2"> How are you feeling today? </h2>
  </section>
  <div class="form">
    <%= simple_form_for [@user, @pet, @log] do |f| %>
      <%= f.input :date, as: :date,
        use_short_month: true,
        label: "Date",
        required: false,
        input_html: { style: "width: 300px;" },
        wrapper_html: { style: "max-width: 320px;" } %>
      <% (1..5).each do |i| %>
        <!-- Recieve the attribute names -->
        <% title = @pet.read_attribute("attr#{i}") %>
        <!-- Skip if blank -->
        <% next if title.blank? %>
        <div data-controller="rating" class="rating">
          <div class="rating-header">
            <h5><%= title %></h5>
            <button data-action="click->rating#openModal" class="btn modal-btn">
              <i class="iconify" data-icon="material-symbols-light:add-notes-outline" data-width="32" data-height="32"></i>
            </button>
          </div>
          <!-- Make buttons for rating -->
          <div class="rating-btns">
            <% (1..5).each do |value| %>
              <button class="rating-btn"
                data-rating-text-value="<%= "#{value} attr#{i}" %>"
                data-action="click->rating#select"
                data-rating-target="button">
                <i class="fa-regular <%=reactions[value - 1]%> fa-lg"></i>
              </button>
            <% end %>
          </div>
          <%= f.input "attr#{i}",
            as: :hidden,
            input_html: { value: @pet.read_attribute("attr#{i}") } %>
          <%= f.input "attr#{i}_value",
            id: "attr#{i}value",
            input_html: { data: { rating_target: "input" } },
            collection: 0..5,
            as: :hidden %>
          <%= f.input "attr#{i}_memo", as: :hidden, input_html: { id: "log_attr#{i}_memo_hidden" } %>
          <!-- Modal -->
          <div class="memo-modal d-none">
            <div>
              <div class="memo-modal-content">
                <div class="memo-modal-header">
                  <h5><%= title %> Notes</h5>
                </div>
                <textarea class="memo-textarea" id="memo_attr#{i}_temp" rows="4" placeholder="Add notes..."></textarea>
                <div class="memo-modal-actions">
                  <button type="button" class="btn btn-secondary" data-action="click->rating#cancelMemo">Cancel</button>
                  <button type="button" class="btn btn-primary" data-action="click->rating#saveMemo">Save</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
      <div class="d-flex justify-content-center align-items-center gap-3 ">
        <%= link_to "Cancel", user_pet_logs_path(@user, @pet), class: 'btn btn-danger text-white' %>
        <%= f.button :submit, "Save", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
