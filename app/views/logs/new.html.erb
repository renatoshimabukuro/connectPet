<% reactions = ["fa-face-tired",
    "fa-face-frown",
    "fa-face-meh",
    "fa-face-smile",
    "fa-face-grin-wide" ]%>
<div class= "pet-show-container">
  <section class="pet-hero-section">
    <div class="avatar-carousel">
      <div class="avatar-secondary"></div>
      <div class="avatar-main">
        <% if @pet.photo.attached? %>
          <%= image_tag @pet.photo, class: "avatar-large", style: "width: 80px; height: 80px; border-radius: 50%; object-fit: cover;" %>
        <% else %>
          <i class="fa-solid fa-paw" style="font-size: 80px; color: rgba(255,255,255,0.5);"></i>
        <% end %>
      </div>
      <div class="avatar-secondary"></div>
    </div>
    <h1> Hello, <%= @pet.name %></h1>
    <h2 class="mt-2"> How are you feeling today? </h2>
  </section>
  <div class="form">
    <%= simple_form_for [@user, @pet, @log] do |f| %>
      <%= f.input :date, as: :date,
        use_short_month: true,
        label: "Date",
        input_html: { style: "width: 300px;"},
        wrapper_html: { style: "max-width: 320px;"} %>
      <%#  %>
      <%= f.simple_fields_for :log_values do |lv| %>
        <% pet_attr = lv.object.pet_attribute %>
        <% attr = pet_attr.attribute_definition %>
        <div data-controller="rating" class="rating">
          <div class= "rating-header">
            <h5><%= attr.name%> </h5>
            <button data-action="click->rating#openModal" class="btn modal-btn">
              <i class="iconify"
                data-icon="material-symbols-light:add-notes-outline"
                data-width="32"
                data-height="32"></i>
            </button>
          </div>
          <%#  %>
          <%# If value is a range %>
          <% if attr.range? %>
            <div class="rating-btns">
              <% (1..5).each do |value| %>
                <button class="rating-btn"
                  data-value="<%= value %>"
                  data-action="click->rating#select"
                  data-rating-target="button">
                  <i class="fa-regular <%= reactions[value - 1] %> fa-lg"></i>
                </button>
              <% end %>
            </div>
            <%= lv.input :range_value, as: :hidden, input_html: { data: { rating_target: "input" } } %>
          <% else %>
            <%# If it's a boolean %>
            <div class="rating-btns">
              <button type="button"
                class= "btn btn-outline-primary"
                data-action="click->rating#selectBoolean"
                data-value="true">
                Yes
              </button>
              <button type="button"
                class= "btn btn-outline-primary"
                data-action="click->rating#selectBoolean"
                data-value="false">
                No
              </button>
            </div>
            <%= lv.input :boolean_value, as: :hidden, input_html: { data: { rating_target: "input" } } %>
          <% end %>
          <%# Hidden fields %>
          <%= lv.hidden_field :pet_attribute_id %>
          <%= lv.input :memo, as: :hidden,
            input_html: { id: "log_attr_#{pet_attr.id}_memo_hidden" } %>
          <%# Modal %>
          <div class="memo-modal d-none">
            <div>
              <div class="memo-modal-content">
                <div class="memo-modal-header">
                  <h5> <%= attr.name %> Notes </h5>
                </div>
                <textarea class="memo-text-area"
                  rows="4" placeholder="Add notes..."></textarea>
                <div class="memo-modal-actions">
                  <button type="button"
                      class="btn btn-secondary"
                      data-action="click->rating#cancelMemo">
                    Cancel
                  </button>
                  <button type="button"
                      class="btn btn-primary"
                      data-action="click->rating#saveMemo">
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
      <div class="d-flex justify-content-center align-items-center gap-3">
        <%= link_to "Cancel", user_pet_logs_path(@user, @pet), class: "btn btn-danger text-white" %>
        <%= f.button :submit, "Save", class: "btn btn-primary" %>
      </div>
    <% end %>
    <%#  %>
    <%# # %>
    <%#  %>
    <%#  %>
    <%#  %>
    --------------------------------------------
  </div>
</div>
